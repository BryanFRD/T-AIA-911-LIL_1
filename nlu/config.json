{
  "tokenizer": {
    "type": "camembert-base",
    "max_length": 128
  },
  "training": {
    "epochs": 8,
    "batch_size": 32,
    "learning_rate": 5e-5,
    "use_crf": true
  },
  "entity_labels": ["O", "B-FROM", "I-FROM", "B-TO", "I-TO", "B-VIA", "I-VIA", "B-PERSON", "I-PERSON"],
  "intent_labels": ["trajet", "other"]
}
