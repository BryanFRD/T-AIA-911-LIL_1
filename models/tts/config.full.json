{
  "_comment": "TTS Full - High quality for server deployment (full VITS)",
  "model": {
    "type": "vits",
    "language": "fr",
    "sample_rate": 22050,
    "hidden_channels": 192,
    "filter_channels": 768
  },
  "training": {
    "max_steps": 1000,
    "eval_steps": 100,
    "save_steps": 500,
    "learning_rate": 2e-4,
    "warmup_steps": 100,
    "batch_size": 16,
    "gradient_accumulation_steps": 1
  },
  "optimization": {
    "use_bf16": false,
    "gradient_checkpointing": false
  },
  "export": {
    "formats": ["onnx"],
    "onnx_opset": 17,
    "quantization": "fp16"
  }
}
