{
  "tokenizer": {
    "type": "camembert-base",
    "max_length": 128
  },
  "training": {
    "epochs": 8,
    "batch_size": 64,
    "learning_rate": 5e-5,
    "use_crf": true,
    "warmup_ratio": 0.05,
    "weight_decay": 0.01,
    "lr_scheduler_type": "cosine",
    "gradient_accumulation_steps": 2,
    "logging_steps": 200,
    "eval_strategy": "epoch",
    "save_strategy": "no"
  },
  "optimization": {
    "use_bf16": false,
    "use_fp16": true,
    "use_tf32": true,
    "cudnn_benchmark": true,
    "dataloader_num_workers": 8,
    "dataloader_prefetch_factor": 2,
    "dataloader_pin_memory": true,
    "use_fused_optimizer": true,
    "pytorch_compile": true
  },
  "export": {
    "formats": ["pytorch", "onnx"],
    "onnx_opset": 17
  },
  "entity_labels": [
    "O",
    "B-FROM",
    "I-FROM",
    "B-TO",
    "I-TO",
    "B-VIA",
    "I-VIA",
    "B-VOICE",
    "I-VOICE",
    "B-TIME",
    "I-TIME",
    "B-DATE",
    "I-DATE",
    "B-TRANSPORT",
    "I-TRANSPORT",
    "B-DEPARTURE_TIME",
    "I-DEPARTURE_TIME",
    "B-ARRIVAL_TIME",
    "I-ARRIVAL_TIME"
  ],
  "intent_labels": ["trajet", "other"]
}
