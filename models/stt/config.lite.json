{
  "_comment": "STT Lite - Optimized for mobile deployment (Whisper Tiny)",
  "model": {
    "type": "whisper-tiny",
    "language": "fr",
    "task": "transcribe"
  },
  "training": {
    "max_steps": 800,
    "eval_steps": 100,
    "save_steps": 400,
    "learning_rate": 1e-5,
    "warmup_steps": 80,
    "batch_size": 16,
    "gradient_accumulation_steps": 1
  },
  "optimization": {
    "use_bf16": true,
    "gradient_checkpointing": false
  },
  "export": {
    "formats": ["onnx"],
    "onnx_opset": 17,
    "quantization": "int8"
  }
}
