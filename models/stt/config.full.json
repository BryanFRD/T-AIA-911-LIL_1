{
  "_comment": "STT Full - High accuracy for server deployment (Whisper Small)",
  "model": {
    "type": "whisper-small",
    "language": "fr",
    "task": "transcribe"
  },
  "training": {
    "max_steps": 1000,
    "eval_steps": 100,
    "save_steps": 500,
    "learning_rate": 1e-5,
    "warmup_steps": 100,
    "batch_size": 8,
    "gradient_accumulation_steps": 2
  },
  "optimization": {
    "use_bf16": true,
    "gradient_checkpointing": true
  },
  "export": {
    "formats": ["onnx"],
    "onnx_opset": 17,
    "quantization": "fp16"
  }
}
