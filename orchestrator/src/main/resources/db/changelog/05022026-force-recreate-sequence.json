{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "force-recreate-seq-v3",
        "author": "Arthur",
        "changes": [
          {
            "sql": {
              "sql": "DROP SEQUENCE IF EXISTS stop_times_id_seq CASCADE;"
            }
          },
          {
            "createSequence": {
              "sequenceName": "stop_times_id_seq",
              "dataType": "bigint",
              "incrementBy": 1,
              "startValue": 1
            }
          },
          {
            "addDefaultValue": {
              "tableName": "stop_times",
              "columnName": "id",
              "defaultValueSequenceNext": "stop_times_id_seq"
            }
          },
          {
            "sql": {
              "dbms": "postgresql",
              "sql": "SELECT setval('stop_times_id_seq', COALESCE((SELECT MAX(id) FROM stop_times), 1));"
            }
          }
        ]
      }
    }
  ]
}