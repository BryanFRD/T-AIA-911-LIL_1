# MLflow tracking URI
MLFLOW_TRACKING_URI=https://mlflow.bryan-ferrando.fr

# Allow insecure TLS for self-signed certificates
MLFLOW_TRACKING_INSECURE_TLS=true

# MinIO/S3 credentials for artifact storage
# Get these from your MLflow administrator
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
MLFLOW_S3_ENDPOINT_URL=https://minio-api.bryan-ferrando.fr
MLFLOW_S3_IGNORE_TLS=true
